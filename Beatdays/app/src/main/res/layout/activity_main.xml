<?xml version="1.0" encoding="utf-8"?>
<com.example.beatdays.ui.game.view.CamadaToqueCafe xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tela_jogo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="false">
    <com.example.beatdays.ui.game.view.CenaCafe
        android:id="@+id/cena_cafe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:importantForAccessibility="no">
        <ImageView
            android:id="@+id/img_fundo_cafe"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/fundo_cafeteria" />
        <com.example.beatdays.ui.game.view.AmbienteCafeView
            android:id="@+id/ambiente_cafe"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:clickable="false"
            android:focusable="false" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_barista"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/descricao_barista"
            android:src="@drawable/barista_idle" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_barista_preparar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/barista_preparar" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_barista_lancar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/barista_lancar" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_barista_despedida"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/barista_despedida" />
        <ImageView
            android:id="@+id/img_balcao_frente"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/fundo_cafeteria" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_cliente"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/descricao_cliente"
            android:src="@drawable/cliente_idle" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_cliente_caminhar_a"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/cliente_caminhar_a" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_cliente_caminhar_b"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/cliente_caminhar_b" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_cliente_receber"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/cliente_receber" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_cliente_pegar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/cliente_pegar" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_cliente_guardar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/cliente_guardar" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_cliente_erro"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/cliente_erro" />
        <com.example.beatdays.ui.game.sprite.SpriteImageView
            android:id="@+id/img_cliente_desapontado"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:src="@drawable/cliente_desapontado" />
        <com.example.beatdays.ui.game.view.EfeitosCafeView
            android:id="@+id/efeitos_cafe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </com.example.beatdays.ui.game.view.CenaCafe>
    <FrameLayout
        android:id="@+id/interface_jogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/hud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/hud_cafe"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/tv_nome_fase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nome_fase"
                android:textColor="@color/menu_honey"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/menu_line" />
            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/score_inicial"
                android:textColor="@color/menu_text"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/tv_combo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/combo_inicial"
                android:textColor="@color/menu_sage"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btn_pausar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:padding="14dp"
            android:background="@drawable/icone_fundo_cafe"
            android:src="@drawable/ic_pause_cafe"
            android:contentDescription="@string/pausar" />
        <TextView
            android:id="@+id/tv_instrucao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:layout_marginHorizontal="24dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:background="@drawable/hud_cafe"
            android:gravity="center"
            android:textColor="@color/menu_text"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/overlay_jogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/menu_scrim_cafe"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp">
            <LinearLayout
                android:id="@+id/menu_cabecalho"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:baselineAligned="false">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_cafeteria"
                    android:textAppearance="@style/TextAppearance.Beatdays.Menu.Label" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sobre"
                style="@style/Widget.Beatdays.Menu.Quiet"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/sobre"
                app:icon="@drawable/ic_info_cafe"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/menu_divisao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent=".43" />
            <ScrollView
                android:id="@+id/menu_marca_scroll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:layout_marginEnd="28dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/menu_divisao"
                app:layout_constraintTop_toBottomOf="@id/menu_cabecalho"
                app:layout_constraintBottom_toTopOf="@id/menu_rodape"
                app:layout_constraintHeight_max="360dp"
                android:scrollbars="vertical"
                android:scrollbarSize="3dp"
                android:scrollbarThumbVertical="@drawable/menu_scrollbar_cafe"
                android:fadeScrollbars="false">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        android:text="@string/menu_marca"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/menu_text"
                        android:letterSpacing="-.025"
                        android:includeFontPadding="false"
                        android:gravity="center_vertical"
                        android:maxLines="2"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="32sp"
                        android:autoSizeMaxTextSize="52sp"
                        android:autoSizeStepGranularity="2sp" />
                    <View
                        android:layout_width="36dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/menu_honey" />
                    <TextView
                        android:id="@+id/tv_menu_descricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                        android:visibility="gone"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tv_recorde"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/menu_chip_cafe"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColor="@color/menu_honey"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/menu_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/menu_card_cafe"
                android:padding="18dp"
                android:elevation="8dp"
                app:layout_constraintStart_toStartOf="@id/menu_divisao"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/menu_cabecalho"
                app:layout_constraintBottom_toTopOf="@id/menu_rodape"
                app:layout_constraintWidth_max="520dp"
                app:layout_constraintHeight_max="360dp">
                <LinearLayout
                    android:id="@+id/menu_titulo_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:id="@+id/tv_menu_etiqueta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Beatdays.Menu.Label"
                        android:text="@string/menu_etiqueta_inicio" />
                    <TextView
                        android:id="@+id/tv_overlay_titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Beatdays.Menu.Title"
                        android:text="@string/nome_fase"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <ScrollView
                    android:id="@+id/menu_scroll_area"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:fillViewport="false"
                    android:overScrollMode="never"
                    app:layout_constraintTop_toBottomOf="@id/menu_titulo_area"
                    app:layout_constraintBottom_toTopOf="@id/menu_acoes"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:scrollbars="vertical"
                    android:scrollbarSize="3dp"
                    android:scrollbarThumbVertical="@drawable/menu_scrollbar_cafe"
                    android:fadeScrollbars="false">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="4dp">
                        <TextView
                            android:id="@+id/tv_overlay_texto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                            android:text="@string/menu_intro" />
                        <LinearLayout
                            android:id="@+id/menu_guia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="4dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginTop="6dp"
                                android:baselineAligned="false">
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:gravity="center"
                                    android:background="@drawable/menu_chip_cafe"
                                    android:text="@string/menu_number_1"
                                    android:textColor="@color/menu_honey"
                                    android:fontFamily="monospace"
                                    android:textSize="13sp" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/menu_mika_guia"
                                    android:textColor="@color/menu_text"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginTop="6dp"
                                android:baselineAligned="false">
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:gravity="center"
                                    android:background="@drawable/menu_chip_cafe"
                                    android:text="@string/menu_number_2"
                                    android:textColor="@color/menu_honey"
                                    android:fontFamily="monospace"
                                    android:textSize="13sp" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/menu_dupla_guia"
                                    android:textColor="@color/menu_text"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_marginTop="6dp"
                                android:baselineAligned="false">
                                <TextView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:gravity="center"
                                    android:background="@drawable/menu_chip_cafe"
                                    android:text="@string/menu_number_3"
                                    android:textColor="@color/menu_honey"
                                    android:fontFamily="monospace"
                                    android:textSize="13sp" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="10dp"
                                    android:text="@string/menu_trio_guia"
                                    android:textColor="@color/menu_text"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_avaliacao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                            android:visibility="gone"
                            android:textColor="@color/menu_sage"
                            android:background="@drawable/menu_badge_sucesso"
                            android:padding="10dp"
                            android:fontFamily="sans-serif-medium" />
                        <LinearLayout
                            android:id="@+id/menu_resultados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginHorizontal="3dp"
                                    android:orientation="vertical"
                                    android:padding="12dp"
                                    android:background="@drawable/menu_tile_cafe">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.Beatdays.Menu.Label"
                                        android:text="@string/menu_pontos" />
                                    <TextView
                                        android:id="@+id/tv_menu_pontos"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/menu_number_0"
                                        android:fontFamily="sans-serif-black"
                                        android:textSize="27sp"
                                        android:textColor="@color/menu_text" />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginHorizontal="3dp"
                                    android:orientation="vertical"
                                    android:padding="12dp"
                                    android:background="@drawable/menu_tile_cafe">
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.Beatdays.Menu.Label"
                                        android:text="@string/menu_combo" />
                                    <TextView
                                        android:id="@+id/tv_menu_combo"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/menu_number_0"
                                        android:fontFamily="sans-serif-black"
                                        android:textSize="27sp"
                                        android:textColor="@color/menu_text" />
                                </LinearLayout>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="6dp"
                                android:baselineAligned="false">
                                <TextView
                                    android:id="@+id/tv_menu_perfect"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:paddingVertical="8dp"
                                    android:text="@string/menu_initial_perfect"
                                    android:textSize="11sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/menu_sage" />
                                <TextView
                                    android:id="@+id/tv_menu_great"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:paddingVertical="8dp"
                                    android:text="@string/menu_initial_great"
                                    android:textSize="11sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/menu_text" />
                                <TextView
                                    android:id="@+id/tv_menu_good"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:paddingVertical="8dp"
                                    android:text="@string/menu_initial_good"
                                    android:textSize="11sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/menu_honey" />
                                <TextView
                                    android:id="@+id/tv_menu_miss"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:paddingVertical="8dp"
                                    android:text="@string/menu_initial_miss"
                                    android:textSize="11sp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/menu_coral" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_pedidos_resultado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                            android:visibility="gone"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/menu_text" />
                        <TextView
                            android:id="@+id/tv_timing_resultado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                            android:visibility="gone"
                            android:layout_marginTop="6dp"
                            android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_sincronia"
                            style="@style/Widget.Beatdays.Menu.Quiet"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/menu_sincronia"
                            android:visibility="gone"
                            app:icon="@drawable/ic_tune_cafe" />
                        <LinearLayout
                            android:id="@+id/painel_sincronia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/menu_tile_cafe"
                            android:clickable="true"
                            android:visibility="gone">
                            <TextView
                                android:id="@+id/tv_sincronia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                                android:text="@string/sincronia_inicial"
                                android:textColor="@color/menu_honey"
                                android:fontFamily="sans-serif-medium" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                                android:text="@string/sincronia_ajuda"
                                android:textSize="11sp"
                                android:layout_marginTop="4dp" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:baselineAligned="false">
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_adiantar_cena"
                                    style="@style/Widget.Beatdays.Menu.Secondary"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:text="@string/sincronia_menos"
                                    android:textSize="12sp"
                                    android:paddingHorizontal="4dp"
                                    android:contentDescription="@string/sincronia_adiantar" />
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_zerar_sincronia"
                                    style="@style/Widget.Beatdays.Menu.Quiet"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:text="@string/sincronia_zerar"
                                    android:paddingHorizontal="4dp" />
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btn_atrasar_cena"
                                    style="@style/Widget.Beatdays.Menu.Secondary"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:text="@string/sincronia_mais"
                                    android:textSize="12sp"
                                    android:paddingHorizontal="4dp"
                                    android:contentDescription="@string/sincronia_atrasar" />
                            </LinearLayout>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.Beatdays.Menu.Body"
                                android:text="@string/sincronia_proxima"
                                android:textSize="11sp"
                                android:layout_marginTop="6dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_recomecar_ajuste"
                                style="@style/Widget.Beatdays.Menu.Secondary"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="6dp"
                                android:text="@string/sincronia_recomecar"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
                <LinearLayout
                    android:id="@+id/menu_acoes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toTopOf="@id/tv_overlay_dica"
                    android:baselineAligned="false">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_treinar"
                        style="@style/Widget.Beatdays.Menu.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/menu_treinar"
                        app:icon="@drawable/ic_practice_cafe"
                        android:textSize="12sp"
                        android:paddingHorizontal="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_inicio"
                        style="@style/Widget.Beatdays.Menu.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/menu_inicio"
                        app:icon="@drawable/ic_home_cafe"
                        android:visibility="gone"
                        android:textSize="12sp"
                        android:paddingHorizontal="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_acao_menu"
                        style="@style/Widget.Beatdays.Menu.Primary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1.8"
                        android:layout_marginStart="8dp"
                        android:text="@string/menu_comecar"
                        app:icon="@drawable/ic_play_cafe" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_overlay_dica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/menu_hint_start"
                    android:textColor="@color/menu_muted"
                    android:textSize="11sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/menu_rodape"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:gravity="start|center_vertical"
                android:text="@string/credito_musica"
                android:textColor="@color/menu_muted"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</com.example.beatdays.ui.game.view.CamadaToqueCafe>
